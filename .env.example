# ---------------------------------------------------------------------------
# Outbound Intelligence Engine: configuration
#
# Everything runs with this file untouched: file store, synthetic Clay/CRM data,
# mock video/outreach/dialer, console alerts, template copy (no LLM).
# Each section below swaps one mock for the real system. See docs/WIRING.md.
# ---------------------------------------------------------------------------

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Cartage
NEXT_PUBLIC_DEMO_BANNER=true

# --- Sign-in and roles ------------------------------------------------------------
# Demo identity provider: exec@cartage.demo, bdr@cartage.demo, admin@cartage.demo share DEMO_PASSWORD.
# Sessions are HMAC-signed cookies; set a long random AUTH_SECRET in every real environment.
AUTH_SECRET=
DEMO_PASSWORD=demo
# AUTH_DISABLED=true treats every request as admin (local scripts / CI only).
AUTH_DISABLED=false

# --- Intelligence (Claude) ------------------------------------------------------
# Without a key every agent uses its template path; with a key the agents write
# explanations, briefs, playbooks, copy and talk tracks.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_EXPLAIN_TOP_N=25

# --- Store: file (zero config) | memory (ephemeral demo hosting) | supabase -------
# On Vercel the default becomes "memory" with AUTO_SEED=true so every cold start
# boots with the synthetic dataset already scored. Use supabase for anything real.
STORE_PROVIDER=file
DATA_DIR=.data
AUTO_SEED=false
AUTO_SEED_COUNT=60
# STORE_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Secret key (sb_secret_...) or legacy service-role key. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Agent runtime ----------------------------------------------------------------
AGENT_TICK_SECONDS=20
AGENT_BATCH_SIZE=25
AGENT_LLM_CONCURRENCY=3
# Protects /api/agents/tick when a scheduler calls it (Vercel Cron sends this header automatically).
CRON_SECRET=

# --- Engine thresholds ----------------------------------------------------------------
QUALIFICATION_THRESHOLD=70
HOT_THRESHOLD=60
ALERT_COOLDOWN_MINUTES=240
RESCORE_AFTER_LEARN=true

# --- Discovery: mock | clay --------------------------------------------------------------
DISCOVERY_PROVIDER=mock
# Clay table "Monitor webhook" source URLs (copy from the Clay UI) and the optional token Clay shows once.
CLAY_DISCOVERY_WEBHOOK_URL=
CLAY_ENRICHMENT_WEBHOOK_URL=
CLAY_WEBHOOK_TOKEN=
# Secret we require in the x-webhook-secret header when Clay's HTTP API column calls /api/webhooks/clay.
CLAY_WEBHOOK_SECRET=
# Per-signal-type source routing: discovery (whatever discovery collected) | clay | native (Claude + web search).
# Flip one type at a time to "native" to replace Clay incrementally.
SIGNAL_SOURCE_HIRING=discovery
SIGNAL_SOURCE_EXPANSION=discovery
SIGNAL_SOURCE_TECHNOLOGY=discovery
SIGNAL_SOURCE_PAIN=discovery

# --- Jerry (Cartage's sales-intelligence agent): local | mcp -------------------------------
JERRY_MODE=local
JERRY_KNOWLEDGE_DIR=knowledge/jerry
# When the real Jerry speaks MCP: Streamable HTTP URL or a stdio command.
JERRY_MCP_URL=
JERRY_MCP_COMMAND=
JERRY_MCP_TOKEN=

# --- Enrichment data source Jerry calls: mock | clay | http ---------------------------------
ENRICHMENT_PROVIDER=mock
ENRICHMENT_API_URL=
ENRICHMENT_API_KEY=

# --- Video: mock | tavus ---------------------------------------------------------------------
VIDEO_PROVIDER=mock
TAVUS_API_KEY=
# face_id / replica_id of the trained Phoenix face
TAVUS_REPLICA_ID=
# Token appended to the callback URL (?token=...) because Tavus callbacks are unsigned.
TAVUS_WEBHOOK_SECRET=

# --- Outreach: mock | resend | sequencer (Cartage Sequencer) -------------------------------------
# mock/resend: the engine schedules and sends email touches; LinkedIn, InMail and gift touches
# become rep tasks in the dashboard. sequencer: Cartage's system owns the whole cadence.
OUTREACH_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
RESEND_TEST_TO=
SEQUENCER_API_URL=
SEQUENCER_API_KEY=

# --- Dialer: mock | cartage (Cartage Dialer) -------------------------------------------------------
DIALER_PROVIDER=mock
DIALER_API_URL=
DIALER_API_KEY=

# --- Analytics mirror: none | posthog ----------------------------------------------------------------
ANALYTICS_PROVIDER=none
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# --- Rep alerts: console | slack ------------------------------------------------------------------------
ALERT_PROVIDER=console
SLACK_WEBHOOK_URL=
# or a bot token + channel for chat.postMessage
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# --- CRM (historical conversions + outcome write-back): mock | http ----------------------------------------
CRM_PROVIDER=mock
CRM_EXPORT_URL=
CRM_API_KEY=

# --- Visitor identification (RB2B webhook) and booking (Calendly) ---------------------------------------------
# Token in the webhook URL: /api/webhooks/rb2b?token=<RB2B_WEBHOOK_SECRET>
RB2B_WEBHOOK_SECRET=
# Calendly scheduling link for the booking embed; leave empty for the built-in request form.
NEXT_PUBLIC_CALENDLY_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=
