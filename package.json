{
  "name": "outbound-intel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-improving outbound intelligence engine: learn from historical conversions, discover and score accounts, launch personalized campaigns, track engagement, activate reps, learn again.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "learn": "tsx scripts/learn.ts",
    "score": "tsx scripts/score.ts",
    "demo": "tsx scripts/demo.ts",
    "reset": "tsx scripts/reset.ts",
    "worker": "tsx scripts/worker.ts",
    "mcp": "tsx mcp/server.ts",
    "test": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 --test-force-exit \"test/**/*.test.ts\"",
    "check": "tsx scripts/check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke",
    "journey": "tsx scripts/journey.ts",
    "user:add": "tsx scripts/user-add.ts",
    "contracts:doc": "tsx scripts/contracts-doc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
